# API base URL (optional)
# - Dev default is "/api" (Vite proxy -> http://localhost:4000)
# - If you deploy API separately, set to something like "https://your-api.example.com"
VITE_API_BASE_URL=http://localhost:4000/api

# Google Maps JavaScript usage in the client (browser key)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Server port (optional)
PORT=4000

# Database (MySQL / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=smartgo

# Enable TLS for DB connection (optional; useful for TiDB Cloud)
# Accepted truthy values: 1, true, yes, on
DB_SSL=false
# Only used when DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Google Maps Web Services (used by server-side geocoding / places requests)
GOOGLE_MAPS_API_KEY=your_google_maps_server_key_here

# Gemini (Google Generative AI) for itinerary generation/chat
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; if empty, server will try a built-in fallback model list
GEMINI_MODEL=

# Web app URL used in password-reset emails
FRONTEND_URL=http://localhost:5173

# Resend email delivery (leave blank to disable email sending)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Password-reset token lifetime in minutes
PASSWORD_RESET_TOKEN_MINUTES=20
